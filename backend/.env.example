# Copy to .env and fill in real values. NEVER commit .env. Placeholders only in this file.

# Flask
SECRET_KEY=change-me-long-random-string
LOG_LEVEL=INFO

# Auth
JWT_SECRET_KEY=change-me-another-long-random-string
JWT_ACCESS_TOKEN_HOURS=8
JWT_REMEMBER_DAYS=7

# Database (mysql+pymysql://USER:PASSWORD@HOST:PORT/DBNAME)
DATABASE_URL=mysql+pymysql://user:password@host:3306/visual_schedule

# Frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
