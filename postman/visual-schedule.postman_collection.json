{
  "info": {
    "name": "Visual Schedule API",
    "description": "Runs the whole API in order with assertions. Start the backend first (http://127.0.0.1:5000), then run the collection (Postman Runner, or `npx newman run postman/visual-schedule.postman_collection.json`). Fictional data only. Each run registers fresh fictional users and deletes the child it creates. The token is kept in the {{token}} collection variable; never paste a real token into this file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "token2",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "email2",
      "value": ""
    },
    {
      "key": "childId",
      "value": ""
    },
    {
      "key": "scheduleId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "extraTaskId",
      "value": ""
    },
    {
      "key": "cardId",
      "value": ""
    },
    {
      "key": "scheduleDate",
      "value": ""
    },
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1 Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 Auth",
      "item": [
        {
          "name": "POST register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Caregiver\",\n  \"email\": \"{{email}}\",\n  \"password\": \"DemoPass123\",\n  \"role\": \"caregiver\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a fresh fictional address each run",
                  "pm.collectionVariables.set('email', 'postman.' + Date.now() + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('no password data is returned', () => { pm.expect(u).to.not.have.property('password'); pm.expect(u).to.not.have.property('password_hash'); });",
                  "pm.test('default settings present', () => pm.expect(u.settings.font_size).to.eql('M'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST register (duplicate email gives 409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Caregiver\",\n  \"email\": \"{{email}}\",\n  \"password\": \"DemoPass123\",\n  \"role\": \"caregiver\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('error names the email field', () => pm.expect(pm.response.json().error.fields.email).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST register (invalid input gives 400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"role\": \"wizard\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('every bad field is listed', () => pm.expect(Object.keys(pm.response.json().error.fields)).to.include.members(['name','email','password','role']));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"DemoPass123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('token', b.access_token);",
                  "pm.test('token and expiry returned', () => { pm.expect(b.access_token).to.be.a('string'); pm.expect(b.expires_in).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST login (wrong password gives the generic 401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"WrongPass123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('generic message', () => pm.expect(pm.response.json().error.code).to.eql('invalid_credentials'));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('email matches', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET me (no token gives 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH me (settings)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"font_size\": \"L\",\n    \"contrast\": \"high\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('settings saved, others unchanged', () => { const s = pm.response.json().settings; pm.expect(s.font_size).to.eql('L'); pm.expect(s.contrast).to.eql('high'); pm.expect(s.language).to.eql('en'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH me (bad setting gives 400)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": {\n    \"font_size\": \"XXL\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('error key is settings.font_size', () => pm.expect(pm.response.json().error.fields['settings.font_size']).to.exist);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 Children",
      "item": [
        {
          "name": "POST child",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/children",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mika\",\n  \"age\": 6,\n  \"delay_domain\": \"speech\",\n  \"notes\": \"Likes trains\",\n  \"photo_url\": \"train\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('childId', pm.response.json().id);",
                  "pm.test('fields echoed', () => pm.expect(pm.response.json().name).to.eql('Mika'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST child (age 0 gives 400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/children",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mika\",\n  \"age\": 0,\n  \"delay_domain\": \"speech\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('age is flagged', () => pm.expect(pm.response.json().error.fields.age).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET children",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/children"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('paged list shape', () => { const b = pm.response.json(); pm.expect(b.items).to.be.an('array'); pm.expect(b.total).to.be.at.least(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET child",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/children/{{childId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
