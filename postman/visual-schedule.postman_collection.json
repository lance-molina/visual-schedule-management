                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT child (replaces; omitted notes become null)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/children/{{childId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mika\",\n  \"age\": 7,\n  \"delay_domain\": \"speech\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('age updated and notes cleared', () => { const c = pm.response.json(); pm.expect(c.age).to.eql(7); pm.expect(c.notes).to.eql(null); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 Schedules",
      "item": [
        {
          "name": "POST schedule with tasks",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/schedules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": {{childId}},\n  \"date\": \"{{scheduleDate}}\",\n  \"tasks\": [\n    {\n      \"name\": \"Brush teeth\",\n      \"icon\": \"fa-tooth\",\n      \"category\": \"hygiene\",\n      \"time\": \"07:30\",\n      \"duration\": 10,\n      \"reminder_minutes\": 5\n    },\n    {\n      \"name\": \"Play time\",\n      \"icon\": \"fa-puzzle-piece\",\n      \"category\": \"play\",\n      \"time\": \"08:00\",\n      \"duration\": 30\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A date 30 to 400 days ahead, so reruns do not collide with an existing schedule",
                  "const d = new Date(Date.now() + (30 + Math.floor(Math.random() * 370)) * 86400000);",
                  "pm.collectionVariables.set('scheduleDate', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.collectionVariables.set('scheduleId', s.id);",
                  "pm.collectionVariables.set('taskId', s.tasks[0].id);",
                  "pm.test('two tasks, positions 1 and 2', () => pm.expect(s.tasks.map(t => t.position)).to.eql([1, 2]));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST schedule (same date gives 409)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/schedules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": {{childId}},\n  \"date\": \"{{scheduleDate}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST schedule (bad task gives 400 and saves nothing)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/schedules",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": {{childId}},\n  \"date\": \"2099-01-01\",\n  \"tasks\": [\n    {\n      \"name\": \"\",\n      \"icon\": \"x\",\n      \"category\": \"nope\",\n      \"time\": \"7:30\",\n      \"duration\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('errors name the task and field', () => pm.expect(pm.response.json().error.fields['tasks[0].name']).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET schedules of a child on a date",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/schedules/{{childId}}?date={{scheduleDate}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('exactly one, with tasks', () => { const b = pm.response.json(); pm.expect(b.items.length).to.eql(1); pm.expect(b.items[0].tasks.length).to.eql(2); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT schedule (date only)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/schedules/{{scheduleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2098-12-31\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('date changed', () => pm.expect(pm.response.json().date).to.eql('2098-12-31'));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT schedule (sending tasks gives 400)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/schedules/{{scheduleId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2098-12-31\",\n  \"tasks\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 Tasks",
      "item": [
        {
          "name": "GET tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{scheduleId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('in position order', () => { const p = pm.response.json().items.map(t => t.position); pm.expect(p).to.eql([...p].sort((a, b) => a - b)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST task (position defaults to the end)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule_id\": {{scheduleId}},\n  \"name\": \"Eat breakfast\",\n  \"icon\": \"fa-utensils\",\n  \"category\": \"food\",\n  \"time\": \"08:30\",\n  \"duration\": 20\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('extraTaskId', pm.response.json().id);",
                  "pm.test('position is 3', () => pm.expect(pm.response.json().position).to.eql(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT task (partial)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Brush teeth well\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only the name changed', () => { const t = pm.response.json(); pm.expect(t.name).to.eql('Brush teeth well'); pm.expect(t.duration).to.eql(10); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH task complete (server sets completed_at)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('completed with a UTC timestamp', () => { const t = pm.response.json(); pm.expect(t.status).to.eql('completed'); pm.expect(t.completed_at).to.match(/Z$/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH task complete again (idempotent)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/complete"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT task status pending (Undo)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"pending\"\n}"
            }
          },
          "event": [
            {
